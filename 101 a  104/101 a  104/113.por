programa {
  funcao inicio() {
    inteiro numero[5]

    escreva("Informe o número da posição 0: ")
    leia(numero[0])
    escreva("Informe o número da posição 1: ")
    leia(numero[1])
    escreva("Informe o número da posição 2: ")
    leia(numero[2])

    numero[3] = 200
    numero[4] = 300

    escreva("Conteúdo completo: ", numero)
  }
}
