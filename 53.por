programa {
  funcao inicio() {

    inteiro n1, n2, n3, n4, n5
    inteiro soma = 0

    escreva("Informe seu primeiro número: ")
    leia(n1)

    escreva("Informe seu segundo número: ")
    leia(n2)

    escreva("Informe seu terceiro número: ")
    leia(n3)

    escreva("Informe seu quarto número: ")
    leia(n4)

    escreva("Informe seu quinto número: ")
    leia(n5)

    
    soma = soma + n1 + n2 + n3 + n4 + n5
        escreva(soma)
  }
}
